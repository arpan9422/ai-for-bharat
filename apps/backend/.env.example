# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rupeezy_agent
REDIS_URL=redis://localhost:6379

# Pinecone (Vector DB)
PINECONE_API_KEY=
PINECONE_INDEX=rupeezy-knowledge
PINECONE_ENVIRONMENT=us-east-1-aws

# AWS S3 (Call Recordings)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=rupeezy-call-recordings

# Deepgram STT
DEEPGRAM_API_KEY=

# Sarvam AI TTS
SARVAM_API_KEY=

# Ollama Cloud LLM
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:70b
OLLAMA_MODEL_FAST=llama3.1:8b

PORT=4000
