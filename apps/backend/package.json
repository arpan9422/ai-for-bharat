{
  "name": "rupeezy-backend",
  "version": "1.0.0",
  "description": "Express backend for Rupeezy AI Voice Agent",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup": "npm install && prisma generate && prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:fillers": "ts-node src/scripts/seedFillerAudio.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@deepgram/sdk": "^3.3.0",
    "@langchain/core": "^1.1.43",
    "@langchain/langgraph": "^1.2.9",
    "@pinecone-database/pinecone": "^3.0.0",
    "@prisma/client": "^5.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "ollama": "^0.6.3",
    "openai": "^6.35.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.39",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@vitest/ui": "^4.1.5",
    "fast-check": "^4.7.0",
    "nodemon": "^3.1.3",
    "prisma": "^5.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5"
  }
}
